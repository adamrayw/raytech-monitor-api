DATABASE_URL=postgresql+psycopg://USER:PASSWORD@raytech-postgres:5432/raytech_monitor

FRONTEND_URL=https://monitor.raytech.cloud

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.monitor.raytech.cloud/auth/google/callback

SESSION_SECRET=

MONITOR_DEV_TOKEN=
MONITOR_DEV_USER_EMAIL=

# Transactional Email Alerts (Resend)
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Raytech Monitor <onboarding@resend.dev>
EMAIL_REPLY_TO=
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
EMAIL_DAILY_SEND_LIMIT=80
EMAIL_PER_USER_DAILY_LIMIT=20
EMAIL_MAX_ATTEMPTS=5
EMAIL_BATCH_SIZE=20
EMAIL_POLL_INTERVAL_SECONDS=10

# Payment Gateways
# Duitku Sandbox Gateway
DUITKU_MODE=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=https://api.monitor.raytech.cloud/webhooks/duitku
DUITKU_RETURN_URL=https://monitor.raytech.cloud/settings/billing

# Xendit Sandbox Gateway
XENDIT_MODE=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Controlled Sandbox Testing Access (comma-separated emails, user IDs, or * for test suite)
SANDBOX_CHECKOUT_ALLOWLIST=@raytech.cloud

